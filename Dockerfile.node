# ── Node.js Server ──────────────────────────────────────────────
FROM node:18-slim

WORKDIR /app

# Copy dependency manifest first (better layer caching)
COPY package.json package-lock.json* ./

# Install Node dependencies
RUN npm install --omit=dev

# Copy all project source files
COPY . .

# Create uploads directory (multer needs it)
RUN mkdir -p uploads

EXPOSE 3000

CMD ["node", "server.js"]
